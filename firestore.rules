rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Provision access/{uid} manually in Firebase Console.
    // Each document: { role: "student" } or { role: "parent" }.
    // Nobody can create or change roles from the public web app.
    match /access/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    function role() {
      return request.auth != null
        && exists(/databases/$(database)/documents/access/$(request.auth.uid))
        ? get(/databases/$(database)/documents/access/$(request.auth.uid)).data.role
        : null;
    }
    match /classrooms/cloudberry/students/gabriella {
      allow read: if role() in ['student', 'parent'];
      allow create, update: if role() == 'student'
        && request.resource.data.keys().hasOnly(['state', 'updatedAt'])
        && request.resource.data.state is map
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}