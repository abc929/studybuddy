rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in Google account can access only its own profile document.
    // Gabriella's device and Mom's device must use the same account.
    match /profiles/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validProfile() {
        return request.resource.data.keys().hasOnly(['state', 'updatedAt'])
          && request.resource.data.state is map
          && request.resource.data.state.keys().hasOnly([
            'tasks', 'sessions', 'model', 'stars', 'day', 'days'
          ])
          && request.resource.data.state.tasks is map
          && request.resource.data.state.sessions is list
          && request.resource.data.state.sessions.size() <= 50
          && request.resource.data.state.model is map
          && request.resource.data.state.stars is number
          && request.resource.data.state.days is list
          && request.resource.data.state.days.size() <= 60
          && request.resource.data.updatedAt == request.time;
      }

      allow read: if isOwner();
      allow create, update: if isOwner() && validProfile();
      allow delete: if isOwner();
    }

    // Everything else is private by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
